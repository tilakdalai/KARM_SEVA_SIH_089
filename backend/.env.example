# SHRAMSETU Backend Configuration

# Application
APP_NAME=SHRAMSETU
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@localhost:5432/shramsetu_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shramsetu_db

# Security & Authentication
SECRET_KEY=shramsetu_super_secret_jwt_key_sih2024_gov_portal_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay Integration (Test Mode for SIH Prototype)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Cloudinary (Media & Certificate Storage)
CLOUDINARY_CLOUD_NAME=shramsetu_cloud
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Firebase Cloud Messaging (Web Push Notifications)
FIREBASE_CREDENTIALS_PATH=
